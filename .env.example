# .env.example — copy to .env.local and fill in your values
# Get these from: Supabase Dashboard → Settings → API

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret key — server-side only, never expose to the browser
# Required for admin operations (seed scripts, service-level DB access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
